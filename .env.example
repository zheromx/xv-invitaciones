# Variables de entorno de ejemplo — copia a '.env' y completa los valores.

# PostgreSQL
DATABASE_URL=
DIRECT_URL=

# Auth.js v5 — secreto canónico para firmar la sesión JWT.
# Generarlo con: npx auth secret
AUTH_SECRET=

# Opcional: en despliegues locales o detrás de un proxy sin la variable
# de entorno de Vercel/Netlify, Auth.js exige confiar en el host.
# Vercel lo detecta automáticamente; en otros entornos de producción
# descomenta la siguiente línea con valor 'true'.
# AUTH_TRUST_HOST=true

# URL pública de la app para armar el link de cada invitación
# (copiar enlace / compartir por WhatsApp). Sin barra final.
# Si se omite, se infiere de los headers de la petición (x-forwarded-proto/host);
# en producción con Vercel esto suele ser suficiente.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com